# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Discord Developer Portal (https://discord.com/developers/applications) ---
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the application's OAuth2 page.
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/oauth/callback

# --- Database (Supabase Postgres, transaction pooler, port 6543) ---
# For local dev/tests you can instead use: pglite://./.data/dev
DATABASE_URL=

# --- AI (Groq, free tier, https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- App secrets (generate your own; do not reuse these examples) ---
# 32-byte key, base64: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Bearer token the cron sweeper must present to POST /api/cron/jobs
CRON_SECRET=
# Session cookie signing; `openssl rand -base64 32`
SESSION_SECRET=

# --- App config ---
APP_BASE_URL=http://localhost:3000
# Set to "true" to allow self-serve signup (useful for graders); leave unset/false in prod
# once your own admin account exists.
ALLOW_SIGNUP=true

# --- Seed script (npm run seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
